{
    "name": "aldeebhasan/php-archaeology",
    "description": "Dig through the git history of your PHP project: find fossils, living fossils and erosion zones.",
    "type": "library",
    "license": "MIT",
    "keywords": ["dead-code", "git", "analysis", "dev", "static-analysis"],
    "homepage": "https://github.com/aldeebhasan/php-archaeology",
    "authors": [
        { "name": "Hasan Deeb" }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "nikic/php-parser": "^4.18 || ^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "CodeArchaeology\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "CodeArchaeology\\Tests\\": "tests/" }
    },
    "bin": ["bin/archaeo"],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress",
        "check": ["@test", "@stan"]
    },
    "config": {
        "sort-packages": true
    }
}
